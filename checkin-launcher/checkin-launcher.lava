/-
    Rock Check-in Launcher (Nextgen check-in)
    One tap opens check-in fully configured. Each active value in the launcher
    Defined Type becomes a button. See README.md for setup.
-/

//- ===== SETTINGS: change these for your Rock =====
{%- assign launcherDefinedTypeId = 0 -%}                    //- Id of your launcher Defined Type
{%- assign defaultConfigId = 0 -%}                          //- Check-in configuration used when a button doesn't set one
{%- assign pageHeading = 'Select Check-In Type:' -%}
//- Colors for this launcher page only. Blank = use the page's site theme (the Theme set on this page's
//- site under Admin Tools > Settings > CMS > Sites). Not related to the per-button check-in Theme.
{%- assign pageBackgroundColor = '' -%}                     //- e.g. '#1e1b18'. Blank = site theme's background
{%- assign headingColor = '' -%}                            //- Blank = site theme's heading color
{%- assign buttonColor = '' -%}                             //- e.g. '#2e6e73'. Blank = site theme's primary button color
{%- assign buttonTextColor = '' -%}                         //- Blank = site theme's primary button text color
{%- assign revealTaps = 5 -%}                               //- Quick taps in the invisible top-right corner to show each button's areas
{%- assign revealSeconds = 30 -%}                           //- Areas hide again automatically after this many seconds
//- ===== END SETTINGS =====

//- Optional: per-iPad launcher URL like /nextgen-checkin/start?KioskId=12
{%- assign kioskId = 'Global' | PageParameter:'KioskId' | AsInteger -%}

{%- assign definedType = launcherDefinedTypeId | FromCache:'DefinedType' -%}
{%- assign options = definedType.DefinedValues | Where:'IsActive',true -%}

//- Only values with Check-in Areas become buttons. If none have them, launcherDefinedTypeId probably points at the wrong Defined Type.
{%- assign buttonCount = 0 -%}
{%- for option in options -%}
    {%- assign areaCheck = option | Attribute:'CheckInAreas','RawValue' -%}
    {%- if areaCheck != empty and areaCheck != '' -%}{%- assign buttonCount = buttonCount | Plus:1 -%}{%- endif -%}
{%- endfor -%}

<style>
    {%- if pageBackgroundColor != '' %}
    body { background-color: {{ pageBackgroundColor }}; }
    {%- endif %}
    .launcher-heading {
        margin: 20px 0 10px 0;
        {%- if headingColor != '' %} color: {{ headingColor }};{% endif %}
    }
    .launcher {
        position: absolute;
        top: 0;
        left: 0;
        height: 100vh;
        width: 100vw;
        margin: 0;
        padding: 30px 10px 10px 10px;
        display: flex;
        flex-direction: column;
        justify-content: space-around;
        align-items: center;
    }
    .launcher-buttons {
        width: 100%;
        height: 90%;
        margin: auto;
        display: grid;
        padding: 4% 3%;
        gap: 8% 2%;
        grid-template-columns: 48% 48%;
        justify-content: space-evenly;
    }
    .launcher-button {
        min-height: 120px;
        max-height: 40vh;
        text-align: center;
        font-size: 1.4em;
        border-radius: 10px;
        align-content: center;
        {%- if buttonColor != '' %}
        background-color: {{ buttonColor }};
        border-color: {{ buttonColor }};
        {%- endif %}
        {%- if buttonTextColor != '' %}
        color: {{ buttonTextColor }};
        {%- endif %}
    }
    .launcher-areas {
        display: none;
        margin-top: 0.5em;
        font-size: 0.5em;
        font-style: italic;
        font-weight: lighter;
        text-wrap: balance;
    }
    .launcher.show-areas .launcher-areas {
        display: block;
    }
    .launcher-hotspot {
        position: fixed;
        right: 0;
        top: 0;
        width: 80px;
        height: 80px;
        z-index: 10;
    }
</style>

<h2 class="launcher-heading text-uppercase font-weight-bolder ml-5">{{ pageHeading }}</h2>

{%- if definedType == null -%}
    <div class="alert alert-warning m-5">Launcher not configured: no Defined Type found with Id {{ launcherDefinedTypeId }}. Set launcherDefinedTypeId in the settings block.</div>
{%- elseif options == empty -%}
    <div class="alert alert-warning m-5">The "{{ definedType.Name }}" Defined Type has no active values. Add at least one to create a button.</div>
{%- elseif buttonCount == 0 -%}
    <div class="alert alert-warning m-5">The "{{ definedType.Name }}" Defined Type doesn't look like a launcher: none of its values have Check-in Areas. Check launcherDefinedTypeId.</div>
{%- endif -%}
<div class="launcher">
    <div class="launcher-buttons">
        {%- for option in options -%}
            {%- assign configId = option | Attribute:'CheckinConfigId','RawValue' -%}
            {%- if configId == empty or configId == '' -%}{%- assign configId = defaultConfigId -%}{%- endif -%}

            {%- assign theme = option | Attribute:'Theme','RawValue' -%}  //- Optional per-button check-in theme (styles the check-in screens, not this page). Blank = check-in's default

            {%- assign areaIds = option | Attribute:'CheckInAreas','RawValue' -%}
            {%- if areaIds == empty or areaIds == '' -%}{%- continue -%}{%- endif -%}

            {%- capture url -%}
                /nextgen-checkin/setup?CheckinConfigId={{ configId }}&GroupTypeIds={{ areaIds | UrlEncode }}
                {%- if kioskId and kioskId > 0 -%}&KioskId={{ kioskId }}{%- endif -%}
                {%- if theme != '' -%}&Theme={{ theme | UrlEncode }}{%- endif -%}
            {%- endcapture -%}

            <a class="btn btn-primary launcher-button" href="{{ url | Trim }}">
                {{ option.Value }}
                <div class="launcher-areas">{{ option | Attribute:'CheckInAreas' }}</div>
            </a>
        {%- endfor -%}
    </div>
</div>

//- Hidden area reveal: tap the invisible top-right corner quickly to show each button's areas.
<div class="launcher-hotspot" id="launcher-hotspot" aria-hidden="true"></div>
<script>
    (function () {
        const hotspot = document.getElementById('launcher-hotspot');
        const launcher = document.querySelector('.launcher');
        if (!hotspot || !launcher) return;

        const tapsNeeded = {{ revealTaps }};
        const hideAfterMs = {{ revealSeconds }} * 1000;
        let taps = 0;
        let tapTimer = null;
        let hideTimer = null;

        hotspot.addEventListener('click', function () {
            taps++;
            clearTimeout(tapTimer);
            tapTimer = setTimeout(function () { taps = 0; }, 2000);

            if (taps < tapsNeeded) return;
            taps = 0;

            const showing = launcher.classList.toggle('show-areas');
            clearTimeout(hideTimer);
            if (showing) {
                hideTimer = setTimeout(function () { launcher.classList.remove('show-areas'); }, hideAfterMs);
            }
        });
    })();
</script>
